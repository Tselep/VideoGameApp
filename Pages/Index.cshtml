@page
@model VideoGameApp.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4">VideoGameApp</h1>
    <p class="lead">Games loaded from SQLite</p>
</div>

@if (Model.Games == null || Model.Games.Count == 0)
{
    <div class="alert alert-warning">
        No games found. If you just added seed data, delete <code>videogameapp.db</code> and restart the app.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead>
            <tr>
                <th>Title</th>
                <th>Genre</th>
                <th>Studio</th>
                <th class="text-end">Price</th>
                <th>Release Date</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var g in Model.Games)
            {
                <tr>
                    <td>@g.Title</td>
                    <td>@(g.Genre?.Name ?? "-")</td>
                    <td>@(g.Studio?.Name ?? "-")</td>
                    <td class="text-end">@g.Price.ToString("0.00")</td>
                    <td>@(g.ReleaseDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
