@page
@model VideoGameApp.Pages.IndexModel
@{ ViewData["Title"] = "Home"; }

<div class="text-center mb-4">
    <h1 class="display-4">TseleStation</h1>
    <p class="lead text-muted">Official PlayStation Store</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Games</h5>
                <p class="display-6 mb-0">@Model.GamesCount</p>
                <p class="text-muted mb-0">total records</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Genres</h5>
                <p class="display-6 mb-0">@Model.GenresCount</p>
                <p class="text-muted mb-0">total records</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Studios</h5>
                <p class="display-6 mb-0">@Model.StudiosCount</p>
                <p class="text-muted mb-0">total records</p>
            </div>
        </div>
    </div>
</div>

<div class="d-flex flex-wrap gap-2 mb-4">
    <a class="btn btn-primary" asp-page="/Games/Index">Go to Games</a>
    <a class="btn btn-outline-primary" asp-page="/Genres/Index">Go to Genres</a>
    <a class="btn btn-outline-primary" asp-page="/Studios/Index">Go to Studios</a>
</div>

@if (Model.RecentGames.Count == 0)
{
    <div class="alert alert-warning">
        No games found yet.
    </div>
}
else
{
    <h2 class="h5 mb-2">Recently added games</h2>
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Genre</th>
                    <th>Studio</th>
                    <th class="text-end">Price</th>
                    <th>Release Date</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var g in Model.RecentGames)
            {
                <tr>
                    <td>@g.Title</td>
                    <td>@(g.Genre?.Name ?? "-")</td>
                    <td>@(g.Studio?.Name ?? "-")</td>
                    <td class="text-end">@g.Price.ToString("0.00")</td>
                    <td>@(g.ReleaseDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
