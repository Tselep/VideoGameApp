@page
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy Policy";
}
<h1>@ViewData["Title"]</h1>

<><h1>Privacy Policy</h1>

    <p>
        The <strong>TseleStation Store</strong> respects your privacy and is committed
        to protecting your personal data.
    </p>

    <h5>Data Collection</h5>
    <p>
        This application collects only the minimum required user information
        (such as email address) for authentication and authorization purposes.
    </p>

    <h5>Authentication & Authorization</h5>
    <p>
        User authentication is handled via ASP.NET Core Identity.
        Administrative actions (create, edit, delete) are restricted to users
        with the <strong>Admin</strong> role.
    </p>

    <h5>Data Storage</h5>
    <p>
        All application data is stored locally using SQLite and is not shared
        with third parties.
    </p>

    <h5>Contact</h5>
    <p>
        This project was developed as part of the Coding Factory program
        for educational purposes.
    </p>
