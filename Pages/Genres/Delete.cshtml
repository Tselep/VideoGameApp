@page "{id:int}"
@model VideoGameApp.Pages.Genres.DeleteModel

<h1 class="display-6 mb-3 text-danger">Delete Genre</h1>

<p>Are you sure you want to delete this genre?</p>

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Genre.Name</dd>
</dl>

<form method="post">
    <input type="hidden" asp-for="Genre.Id" />
    <button class="btn btn-danger" type="submit">Yes, delete</button>
    <a class="btn btn-outline-secondary" asp-page="./Index">Cancel</a>
</form>