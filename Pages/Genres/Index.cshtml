@page
@model VideoGameApp.Pages.Genres.IndexModel


<h1 class="display-6 mb-3">Genres</h1>
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}
@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
@if (User.IsInRole("Admin"))
{
    <p>
        <a class="btn btn-primary" asp-page="./Create">Create New Genre</a>
    </p>
}

<table class="table table-striped table-hover align-middle">
    <thead>
    <tr>
        <th>Name</th>
        <th class="text-end">Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var g in Model.Genres)
    {
        <tr>
            <td>@g.Name</td>
            <td class="text-end">
                @if (User.IsInRole("Admin"))
                {
                    <a class="btn btn-sm btn-outline-primary" asp-page="./Edit" asp-route-id="@g.Id">Edit</a>
                    <a class="btn btn-sm btn-outline-danger" asp-page="./Delete" asp-route-id="@g.Id">Delete</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>