@using Microsoft.AspNetCore.Identity
@using VideoGameApp.Models
@using VideoGameApp.Services.Cart
@inject ICartService Cart
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TseleStation Store</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/VideoGameApp.styles.css" asp-append-version="true" />
</head>
<body class="bg-body-tertiary">
<header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-semibold" asp-area="" asp-page="/Index">
                <i class="bi bi-controller me-2"></i>TseleStation Store
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/Index"><i class="bi bi-house-door me-1"></i>Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/Games/Index"><i class="bi bi-joystick me-1"></i>Games</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/Genres/Index"><i class="bi bi-tags me-1"></i>Genres</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/Studios/Index"><i class="bi bi-building me-1"></i>Studios</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Orders/Index"><i class="bi bi-receipt me-1"></i>My Orders</a>
                    </li>
                </ul>

                <ul class="navbar-nav ms-auto align-items-lg-center">
                    <li class="nav-item me-lg-2">
                        <a class="nav-link" asp-page="/Cart/Index">
                            <i class="bi bi-cart3 me-1"></i>Cart
                            <span class="badge bg-secondary ms-1">@Cart.GetTotalQuantity()</span>
                        </a>
                    </li>
                    <partial name="_LoginPartial" />
                </ul>
            </div>
        </div>
    </nav>
</header>

<main class="container py-4">
    <div role="main">
        @if (TempData["Success"] is string successMsg)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @successMsg
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["Error"] is string errorMsg)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @errorMsg
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </div>
</main>

<footer class="border-top bg-white">
    <div class="container py-3 small d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
        <div class="text-muted">© @DateTime.Now.Year - TseleStation Store</div>
        <div class="d-flex gap-3">
            <a class="text-decoration-none" asp-page="/Privacy">Privacy Policy</a>
        </div>
    </div>
</footer>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
