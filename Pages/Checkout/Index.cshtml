@page
@model IndexModel

@{
    ViewData["Title"] = "Checkout";
}

<h1>Checkout</h1>

@if (TempData["Info"] is string info)
{
    <div class="alert alert-info">@info</div>
}

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success">@ok</div>
    <a class="btn btn-primary" asp-page="/Games/Index">Continue shopping</a>
}
else if (Model.Items is null || Model.Items.Count == 0)
{
    <div class="alert alert-info">Your cart is empty.</div>
    <a class="btn btn-primary" asp-page="/Games/Index">Continue shopping</a>
}
else
{
    <table class="table align-middle">
        <thead>
        <tr>
        <th>Game</th>
        <th class="text-end">Price</th>
        <th class="text-end">Qty</th>
        <th class="text-end">Line total</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var it in Model.Items)
    {
        <tr>
            <td>@it.Title</td>
            <td class="text-end">€@it.UnitPrice.ToString("0.00")</td>
            <td class="text-end">@it.Quantity</td>
            <td class="text-end">€@((it.UnitPrice * it.Quantity).ToString("0.00"))</td>
        </tr>
    }
    </tbody>
        </table>

        <div class="d-flex justify-content-between align-items-center">
        <a class="btn btn-outline-primary" asp-page="/Cart/Index">Back to cart</a>

        <div class="fs-5">
        <span class="text-muted">Total:</span>
        <strong>€@Model.TotalPrice.ToString("0.00")</strong>
        </div>

        <form method="post" asp-page-handler="PlaceOrder">
        <button class="btn btn-success">Place order</button>
        </form>
        </div>
}