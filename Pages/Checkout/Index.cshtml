@page
@model IndexModel

@{
    ViewData["Title"] = "Checkout";
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
            <div>
                <h1 class="h3 mb-1">Checkout</h1>
                <div class="text-muted small">Review your order and place it when ready.</div>
            </div>

            <a class="btn btn-outline-secondary" asp-page="/Cart/Index">
                <i class="bi bi-arrow-left me-1"></i>Back to cart
            </a>
        </div>
    </div>
</div>

@if (Model.Items is null || Model.Items.Count == 0)
{
    <div class="empty-state text-center">
        <h5 class="mb-2">Your cart is empty</h5>
        <p class="text-muted mb-3">Add some games to proceed to checkout.</p>
        <a class="btn btn-primary" asp-page="/Games/Index">
            <i class="bi bi-joystick me-1"></i>Continue shopping
        </a>
    </div>
}
else
{
    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Game</th>
                                    <th class="text-end">Price</th>
                                    <th class="text-end">Quantity</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var it in Model.Items)
                                {
                                    <tr>
                                        <td class="fw-semibold">@it.Title</td>
                                        <td class="text-end">@($"{it.UnitPrice:0.00} €")</td>
                                        <td class="text-end">@it.Quantity</td>
                                        <td class="text-end">@($"{(it.UnitPrice * it.Quantity):0.00} €")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="mb-3">Order Summary</h5>

                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Items</span>
                        <span>@Model.Items.Count</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Total</span>
                        <strong>@($"{Model.TotalPrice:0.00} €")</strong>
                    </div>

                    <hr />

                    <form method="post" asp-page-handler="PlaceOrder">
                        <button type="submit" class="btn btn-success w-100" title="Place your order">
                            <i class="bi bi-bag-check me-2"></i>Place order
                        </button>
                    </form>

                    <div class="text-muted small mt-3">
                        By placing the order, you confirm your purchase.
                    </div>
                </div>
            </div>
        </div>
    </div>
}