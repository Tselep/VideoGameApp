@page "{id:int}"
@model VideoGameApp.Pages.Games.DetailsModel

<h1 class="display-6 mb-3">Game Details</h1>

<dl class="row">
    <dt class="col-sm-3">Title</dt>
    <dd class="col-sm-9">@Model.Game.Title</dd>

    <dt class="col-sm-3">Genre</dt>
    <dd class="col-sm-9">@Model.Game.Genre?.Name</dd>

    <dt class="col-sm-3">Studio</dt>
    <dd class="col-sm-9">@Model.Game.Studio?.Name</dd>

    <dt class="col-sm-3">Price</dt>
    <dd class="col-sm-9">
        @($"{Model.Game.Price:0.00} €")
    </dd>

    <dt class="col-sm-3">Release Date</dt>
    <dd class="col-sm-9">@(Model.Game.ReleaseDate.HasValue ? Model.Game.ReleaseDate.Value.ToString("yyyy-MM-dd") : "-")</dd>
</dl>

<a class="btn btn-outline-primary" asp-page="Edit" asp-route-id="@Model.Game.Id">Edit</a>
<a class="btn btn-outline-secondary" asp-page="Index">Back</a>