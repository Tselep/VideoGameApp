@page "{id:int}"
@model VideoGameApp.Pages.Games.DetailsModel

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
    <div>
        <h1 class="display-6 mb-0">Game Details</h1>
        <div class="text-muted small">View game information and add it to your cart.</div>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="Index">
            <i class="bi bi-arrow-left me-2"></i>Back
        </a>

        @if (User.IsInRole("Admin") && Model.Game is not null)
        {
            <a class="btn btn-primary" asp-page="Edit" asp-route-id="@Model.Game.Id">
                <i class="bi bi-pencil-square me-2"></i>Edit
            </a>
        }
    </div>
</div>

@if (Model.Game is null)
{
    <div class="alert alert-danger">Game not found.</div>
    <a class="btn btn-outline-secondary" asp-page="Index"><i class="bi bi-arrow-left me-2"></i>Back</a>
    return;
}

<div class="card shadow-soft">
    <div class="card-body">
        <div class="row g-4">
            <div class="col-lg-8">
                <dl class="row mb-0">
                    <dt class="col-sm-3">Title</dt>
                    <dd class="col-sm-9 fw-semibold">@Model.Game.Title</dd>

                    <dt class="col-sm-3">Genre</dt>
                    <dd class="col-sm-9">
                        @if (!string.IsNullOrWhiteSpace(Model.Game.Genre?.Name))
                        {
                            <span class="badge rounded-pill text-bg-light border">@Model.Game.Genre!.Name</span>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </dd>

                    <dt class="col-sm-3">Studio</dt>
                    <dd class="col-sm-9">
                        @if (!string.IsNullOrWhiteSpace(Model.Game.Studio?.Name))
                        {
                            <span class="badge rounded-pill text-bg-light border">@Model.Game.Studio!.Name</span>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </dd>

                    <dt class="col-sm-3">Price</dt>
                    <dd class="col-sm-9 fw-semibold">
                        @($"{Model.Game.Price:0.00} €")
                    </dd>

                    <dt class="col-sm-3">Release Date</dt>
                    <dd class="col-sm-9">
                        @(Model.Game.ReleaseDate.HasValue ? Model.Game.ReleaseDate.Value.ToString("yyyy-MM-dd") : "-")
                    </dd>
                </dl>
            </div>

            <div class="col-lg-4">
                <div class="p-3 p-md-4 bg-body-tertiary rounded-4 border">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-cart-plus"></i>
                        <strong>Add to cart</strong>
                    </div>

                    <form method="post" asp-page="/Cart/Add" class="mt-3">
                        <input type="hidden" name="gameId" value="@Model.Game.Id" />

                        <label class="form-label small text-muted" for="qty">Quantity</label>
                        <div class="d-flex align-items-center gap-2">
                            <input id="qty" class="form-control" style="max-width: 120px;" type="number" name="Quantity" min="1" value="1" />
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-cart-plus me-2"></i>Add
                            </button>
                        </div>
                    </form>

                    <div class="text-muted small mt-3">
                        Tip: You can adjust quantity before adding to the cart.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="d-flex gap-2 mt-3">
    @if (User.IsInRole("Admin"))
    {
        <a class="btn btn-outline-primary" asp-page="Edit" asp-route-id="@Model.Game.Id">
            <i class="bi bi-pencil-square me-2"></i>Edit
        </a>
    }
    <a class="btn btn-outline-secondary" asp-page="Index">
        <i class="bi bi-arrow-left me-2"></i>Back
    </a>
</div>