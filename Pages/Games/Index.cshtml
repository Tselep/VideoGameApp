@page
@model VideoGameApp.Pages.Games.IndexModel

<h1 class="display-6 mb-3">Games</h1>

<p>
    <a class="btn btn-primary" asp-page="Create">Create New Game</a>
</p>

<table class="table table-striped table-hover align-middle">
    <thead>
    <tr>
        <th>Title</th>
        <th>Genre</th>
        <th>Studio</th>
        <th class="text-end">Price</th>
        <th>Release Date</th>
        <th class="text-end">Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var g in Model.Games)
    {
        <tr>
            <td>@g.Title</td>
            <td>@g.Genre?.Name</td>
            <td>@g.Studio?.Name</td>
            <td class="text-end">@g.Price</td>
            <td>@(g.ReleaseDate.HasValue ? g.ReleaseDate.Value.ToString("yyyy-MM-dd") : "-")</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-secondary" asp-page="Details" asp-route-id="@g.Id">Details</a>
                <a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-id="@g.Id">Edit</a>
                <a class="btn btn-sm btn-outline-danger" asp-page="Delete" asp-route-id="@g.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>