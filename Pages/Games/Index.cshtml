@page
@model VideoGameApp.Pages.Games.IndexModel
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
    <div>
        <h1 class="display-6 mb-0">Games</h1>
        <div class="text-muted small">Browse the catalog and add games to your cart.</div>
    </div>

    <div class="d-flex align-items-center">
        <form method="get" class="input-group" role="search" style="width: 600px;">
            <input name="q"
                   value="@Request.Query["q"]"
                   class="form-control"
                   placeholder="Search Games · Genres · Studios · Orders"
                   title="Search Games, Genres, Studios, Orders"
                   aria-label="Search" />

            <button class="btn btn-outline-secondary" type="submit">
                <i class="bi bi-search me-1"></i>Search
            </button>

            @if (!string.IsNullOrWhiteSpace(Request.Query["q"]))
            {
                <a class="btn btn-outline-secondary" asp-page="./Index">
                    <i class="bi bi-x-lg me-1"></i>Clear
                </a>
            }
        </form>

        @if (User.IsInRole("Admin"))
        {
            <a class="btn btn-primary" asp-page="Create">
                <i class="bi bi-plus-lg me-2"></i>Create New Game
            </a>
        }
    </div>
</div>

<div class="card shadow-soft">
    <div class="card-body p-0">
<table class="table table-hover align-middle mb-0">
<thead class="table-light">
<tr>
    <th>Title</th>
    <th>Genre</th>
    <th>Studio</th>
    <th class="text-end">Price</th>
    <th>Release Date</th>
    <th class="text-end">Actions</th>
    <th class="text-end">Buy</th>
</tr>
</thead>
    <tbody>
    @foreach (var g in Model.Games)
    {
        <tr>
            <td>@g.Title</td>
            <td>
                @if (!string.IsNullOrWhiteSpace(g.Genre?.Name))
                {
                    <span class="badge rounded-pill text-bg-light border">@g.Genre!.Name</span>
                }
                else
                {
                    <span class="text-muted">-</span>
                }
            </td>
            <td>
                @if (!string.IsNullOrWhiteSpace(g.Studio?.Name))
                {
                    <span class="badge rounded-pill text-bg-light border">@g.Studio!.Name</span>
                }
                else
                {
                    <span class="text-muted">-</span>
                }
            </td>
            <td class="text-end">
                @($"{g.Price:0.00} €")
            </td>
            <td>@(g.ReleaseDate.HasValue ? g.ReleaseDate.Value.ToString("yyyy-MM-dd") : "-")</td>
            <td class="text-end">
                <div class="btn-group btn-group-sm" role="group">
                    <a class="btn btn-outline-secondary" asp-page="Details" asp-route-id="@g.Id">
                        <i class="bi bi-eye me-1"></i>Details
                    </a>

                    @if (User.IsInRole("Admin"))
                    {
                        <a class="btn btn-outline-primary" asp-page="Edit" asp-route-id="@g.Id">
                            <i class="bi bi-pencil-square me-1"></i>Edit
                        </a>
                        <a class="btn btn-outline-danger" asp-page="Delete" asp-route-id="@g.Id">
                            <i class="bi bi-trash3 me-1"></i>Delete
                        </a>
                    }
                </div>
            </td>
            <td class="text-end">
                <form method="post" asp-page="/Cart/Add" class="d-inline">
                    <input type="hidden" name="gameId" value="@g.Id" />
                    <input type="hidden" name="title" value="@g.Title" />
                    <input type="hidden" name="unitPrice" value="@g.Price" />
                    <input type="hidden" name="imageUrl" value="" />
                    <input type="hidden" name="qty" value="1" />
                    <button type="submit" class="btn btn-sm btn-success">
                        <i class="bi bi-cart-plus me-1"></i>Add
                    </button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3" aria-label="Games pagination">
        <ul class="pagination justify-content-center">

            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-page="./Index"
                   asp-route-pageNumber="@(Model.PageNumber - 1)"
                   asp-route-q="@Request.Query["q"]">
                    Previous
                </a>
            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link"
                       asp-page="./Index"
                       asp-route-pageNumber="@i"
                       asp-route-q="@Request.Query["q"]">
                        @i
                    </a>
                </li>
            }

            <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-page="./Index"
                   asp-route-pageNumber="@(Model.PageNumber + 1)"
                   asp-route-q="@Request.Query["q"]">
                    Next
                </a>
            </li>

        </ul>
    </nav>
}