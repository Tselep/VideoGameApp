@page
@model VideoGameApp.Pages.Cart.IndexModel

@{
    ViewData["Title"] = "Cart";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
    <div>
        <h1 class="display-6 mb-0">Shopping Cart</h1>
        <div class="text-muted small">Review your items and proceed to checkout.</div>
    </div>

    <a class="btn btn-outline-secondary" asp-page="/Games/Index">
        <i class="bi bi-joystick me-2"></i>Continue shopping
    </a>
</div>

@if (!Model.Items.Any())
{
    <div class="alert alert-info d-flex align-items-center gap-2">
        <i class="bi bi-info-circle"></i>
        <div>Your cart is empty.</div>
    </div>
    <a class="btn btn-primary" asp-page="/Games/Index">
        <i class="bi bi-joystick me-2"></i>Browse games
    </a>
}
else
{
    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card shadow-soft">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                            <tr>
                                <th>Game</th>
                                <th class="text-end">Price</th>
                                <th class="text-end">Quantity</th>
                                <th class="text-end">Total</th>
                                <th class="text-end">Actions</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var it in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            @if (!string.IsNullOrWhiteSpace(it.ImageUrl))
                                            {
                                                <img src="@it.ImageUrl" alt="@it.Title"
                                                     style="width: 56px; height: 56px; object-fit: cover;"
                                                     class="rounded" />
                                            }
                                            <div>
                                                <div class="fw-semibold">@it.Title</div>
                                                <div class="text-muted small">#@it.GameId</div>
                                            </div>
                                        </div>
                                    </td>

                                    <td class="text-end">@it.UnitPrice.ToString("0.00") €</td>

                                    <td class="text-end" style="min-width: 240px;">
                                        <form method="post" asp-page-handler="Update" class="d-flex gap-2 justify-content-end">
                                            <input type="hidden" name="gameId" value="@it.GameId" />
                                            <input class="form-control form-control-sm text-end" style="max-width: 96px;"
                                                   type="number" name="qty" min="0" value="@it.Quantity" />
                                            <button type="submit" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-check2 me-1"></i>Update
                                            </button>
                                        </form>
                                        <div class="text-muted small mt-1 text-end">Set to 0 to remove</div>
                                    </td>

                                    <td class="text-end fw-semibold">@((it.UnitPrice * it.Quantity).ToString("0.00")) €</td>

                                    <td class="text-end">
                                        <form method="post" asp-page-handler="Remove" class="d-inline">
                                            <input type="hidden" name="gameId" value="@it.GameId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash3 me-1"></i>Remove
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-soft">
                <div class="card-body">
                    <h5 class="mb-3">Summary</h5>

                    @{ 
                        var qty = Model.TotalQuantity;
                        var itemLabel = qty == 1 ? "item" : "items";
                    }

                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Items</span>
                        <strong>@qty @itemLabel</strong>
                    </div>

                    <div class="d-flex justify-content-between mt-1">
                        <span class="text-muted">Total</span>
                        <strong>@Model.TotalPrice.ToString("0.00") €</strong>
                    </div>

                    <hr />

                    <a class="btn btn-success w-100" asp-page="/Checkout/Index">
                        <i class="bi bi-credit-card me-2"></i>Checkout
                    </a>

                    <form method="post" asp-page-handler="Clear" class="mt-2">
                        <button type="submit" class="btn btn-outline-secondary w-100">
                            <i class="bi bi-x-circle me-2"></i>Clear cart
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}