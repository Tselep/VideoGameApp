@page
@model VideoGameApp.Pages.Cart.IndexModel

@{
    ViewData["Title"] = "Cart";
}

<h1>Cart</h1>

@if (!Model.Items.Any())
{
    <div class="alert alert-info">
        Your cart is empty.
    </div>
    <a class="btn btn-primary" asp-page="/Games/Index">Continue shopping</a>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
            <tr>
                <th>Game</th>
                <th class="text-end">Price</th>
                <th class="text-end">Quantity</th>
                <th class="text-end">Total</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var it in Model.Items)
            {
                <tr>
                    <td>
                        <div class="d-flex align-items-center gap-3">
                            @if (!string.IsNullOrWhiteSpace(it.ImageUrl))
                            {
                                <img src="@it.ImageUrl" alt="@it.Title" style="width: 56px; height: 56px; object-fit: cover;" class="rounded" />
                            }
                            <div>
                                <div class="fw-semibold">@it.Title</div>
                                <div class="text-muted small">#@it.GameId</div>
                            </div>
                        </div>
                    </td>
                    <td class="text-end">@it.UnitPrice.ToString("0.00") €</td>
                    <td>
                        <form method="post" asp-page-handler="Update" class="d-flex gap-2">
                            <input type="hidden" name="gameId" value="@it.GameId" />
                            <input class="form-control" type="number" name="qty" min="0" value="@it.Quantity" />
                            <button type="submit" class="btn btn-primary">Update</button>
                        </form>
                        <div class="text-muted small mt-1">Set to 0 to remove</div>
                    </td>
                    <td class="text-end">@((it.UnitPrice * it.Quantity).ToString("0.00")) €</td>
                    <td class="text-end">
                        <form method="post" asp-page-handler="Remove">
                            <input type="hidden" name="gameId" value="@it.GameId" />
                            <button type="submit" class="btn btn-outline-danger">Remove</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div class="d-flex gap-2">
            <form method="post" asp-page-handler="Clear">
                <button type="submit" class="btn btn-outline-secondary">Clear cart</button>
            </form>
            <a class="btn btn-outline-primary" asp-page="/Games/Index">Continue shopping</a>
        </div>

        @{
            var qty = Model.TotalQuantity;
            var itemLabel = qty == 1 ? "item" : "items";
        }
        <div class="text-end">
            <div class="fs-5">
                <span class="text-muted">Total (@qty @itemLabel):</span>
                <strong>@Model.TotalPrice.ToString("0.00") €</strong>
            </div>
            <a class="btn btn-success mt-2" asp-page="/Checkout/Index">Checkout</a>
        </div>
    </div>
}