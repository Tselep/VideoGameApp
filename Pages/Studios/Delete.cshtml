@page "{id:int}"
@model VideoGameApp.Pages.Studios.DeleteModel

@if (Model.Studio is null)
{
    <div class="alert alert-danger">Studio not found.</div>
    <a class="btn btn-outline-secondary" asp-page="./Index">
        <i class="bi bi-arrow-left me-2"></i>Back
    </a>
    return;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
    <div>
        <h1 class="display-6 mb-0 text-danger">Delete Studio</h1>
        <div class="text-muted small">This action cannot be undone.</div>
    </div>

    <a class="btn btn-outline-secondary" asp-page="./Index">
        <i class="bi bi-arrow-left me-2"></i>Back
    </a>
</div>

<div class="card shadow-soft border-danger">
    <div class="card-body">
        <div class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>
                Are you sure you want to permanently delete this studio?
            </div>
        </div>

        @if (Model.IsInUse)
        {
            <div class="alert alert-warning d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="bi bi-info-circle-fill"></i>
                <div>
                    This studio cannot be deleted because it is used by existing games.
                </div>
            </div>
        }

        <dl class="row mb-4">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9 fw-semibold">@Model.Studio.Name</dd>

            <dt class="col-sm-3">Country</dt>
            <dd class="col-sm-9">@Model.Studio.Country</dd>
        </dl>

        <form method="post" class="d-flex gap-2">
            <input type="hidden" asp-for="Studio.Id" />
            <button class="btn btn-danger" type="submit" @(Model.IsInUse ? "disabled" : "")>
                <i class="bi bi-trash3 me-2"></i>Yes, delete
            </button>
            <a class="btn btn-outline-secondary" asp-page="./Index">Cancel</a>
        </form>
    </div>
</div>