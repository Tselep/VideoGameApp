@page "{id:int}"
@model VideoGameApp.Pages.Studios.DeleteModel

<h1 class="display-6 mb-3 text-danger">Delete Studio</h1>

<p>Are you sure you want to delete this studio?</p>
@if (Model.IsInUse)
{
    <div class="alert alert-warning mt-3">
        Δεν μπορεί να διαγραφεί αυτό το Studio γιατί χρησιμοποιείται από υπάρχοντα Games.
    </div>
}
<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Studio.Name</dd>

    <dt class="col-sm-3">Country</dt>
    <dd class="col-sm-9">@Model.Studio.Country</dd>
</dl>

<form method="post">
    <input type="hidden" asp-for="Studio.Id" />
    <button class="btn btn-danger" type="submit" @(Model.IsInUse ? "disabled" : "")>Yes, delete</button>
    <a class="btn btn-outline-secondary" asp-page="./Index">Cancel</a>
</form>