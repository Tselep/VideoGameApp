@page
@model VideoGameApp.Pages.Studios.IndexModel

<h1 class="display-6 mb-3">Studios</h1>

@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}
@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}

@if (User.IsInRole("Admin"))
{
    <p>
        <a class="btn btn-primary" asp-page="./Create">Create New Studio</a>
    </p>
}

<table class="table table-striped table-hover align-middle">
    <thead>
    <tr>
        <th>Name</th>
        <th>Country</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var s in Model.Studios)
    {
        <tr>
            <td>@s.Name</td>
            <td>@s.Country</td>
            <td class="text-end">
                @if (User.IsInRole("Admin"))
                {
                    <a class="btn btn-sm btn-outline-primary" asp-page="./Edit" asp-route-id="@s.Id">Edit</a>
                    <a class="btn btn-sm btn-outline-danger" asp-page="./Delete" asp-route-id="@s.Id">Delete</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>