@page "{id:int}"
@model VideoGameApp.Pages.Orders.DetailsModel

<h1>Order #@Model.Order!.Id</h1>
<p class="text-muted">
    Order placed: @Model.Order!.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
</p>

<table class="table">
    <thead>
    <tr>
        <th>Game</th>
        <th class="text-end">Price</th>
        <th class="text-end">Quantity</th>
        <th class="text-end">Subtotal</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var it in Model.Order!.OrderItems)
    {
        <tr>
            <td>@it.Game.Title</td>
            <td class="text-end">@it.UnitPrice.ToString("0.00") €</td>
            <td class="text-end">@it.Quantity</td>
            <td class="text-end">@((it.UnitPrice * it.Quantity).ToString("0.00")) €</td>
        </tr>
    }
    </tbody>
</table>

<div class="fs-5 text-end">
    <strong>Order total: @Model.Order!.TotalPrice.ToString("0.00") €</strong>
</div>

<a class="btn btn-outline-primary mt-3" asp-page="/Games/Index">Continue shopping</a>