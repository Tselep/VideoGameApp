@page "{id:int}"
@model VideoGameApp.Pages.Orders.DetailsModel

@if (Model.Order is null)
{
    <div class="alert alert-danger">Order not found.</div>
    <a class="btn btn-outline-secondary" asp-page="./Index">
        <i class="bi bi-arrow-left me-2"></i>Back
    </a>
    return;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
    <div>
        <h1 class="display-6 mb-0">Order #@Model.Order.Id</h1>
        <div class="text-muted small">
            Placed on @Model.Order.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
        </div>
    </div>

    <a class="btn btn-outline-secondary" asp-page="./Index">
        <i class="bi bi-arrow-left me-2"></i>Back to orders
    </a>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card shadow-soft">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                        <tr>
                            <th>Game</th>
                            <th class="text-end">Price</th>
                            <th class="text-end">Quantity</th>
                            <th class="text-end">Total</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var it in Model.Order.OrderItems)
                        {
                            <tr>
                                <td class="fw-semibold">@it.Game.Title</td>
                                <td class="text-end">@it.UnitPrice.ToString("0.00") €</td>
                                <td class="text-end">@it.Quantity</td>
                                <td class="text-end fw-semibold">@((it.UnitPrice * it.Quantity).ToString("0.00")) €</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-soft">
            <div class="card-body">
                <h5 class="mb-3">Order Summary</h5>

                <div class="d-flex justify-content-between">
                    <span class="text-muted">Order ID</span>
                    <strong>#@Model.Order.Id</strong>
                </div>

                <div class="d-flex justify-content-between mt-1">
                    <span class="text-muted">Date</span>
                    <strong>@Model.Order.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</strong>
                </div>

                <hr />

                <div class="d-flex justify-content-between fs-5">
                    <span class="text-muted">Total</span>
                    <strong>@Model.Order.TotalPrice.ToString("0.00") €</strong>
                </div>
            </div>
        </div>
    </div>
</div>

<a class="btn btn-outline-primary mt-3" asp-page="/Games/Index">
    <i class="bi bi-joystick me-2"></i>Continue shopping
</a>