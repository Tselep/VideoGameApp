@page
@model VideoGameApp.Pages.Orders.IndexModel

@{
    ViewData["Title"] = "My Orders";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
    <div>
        <h1 class="display-6 mb-0">My Orders</h1>
        <div class="text-muted small">Your purchase history and order details.</div>
    </div>

    <a class="btn btn-outline-secondary" asp-page="/Games/Index">
        <i class="bi bi-joystick me-2"></i>Browse games
    </a>
</div>

@if (Model.Orders.Count == 0)
{
    <div class="alert alert-info d-flex align-items-center gap-2">
        <i class="bi bi-info-circle"></i>
        <div>You have no orders yet.</div>
    </div>
    <a class="btn btn-primary" asp-page="/Games/Index">
        <i class="bi bi-joystick me-2"></i>Start shopping
    </a>
}
else
{
    <div class="card shadow-soft">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                    <tr>
                        <th>Order #</th>
                        <th>Date</th>
                        <th class="text-end">Total</th>
                        <th class="text-end">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var o in Model.Orders)
                    {
                        <tr>
                            <td class="fw-semibold">#@o.Id</td>
                            <td>@o.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="text-end fw-semibold">@o.TotalPrice.ToString("0.00") €</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary"
                                   asp-page="/Orders/Details"
                                   asp-route-id="@o.Id">
                                    <i class="bi bi-eye me-1"></i>Details
                                </a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}