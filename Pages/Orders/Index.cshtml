@page
@model VideoGameApp.Pages.Orders.IndexModel

@{
    ViewData["Title"] = "My Orders";
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
            <div>
                <h1 class="h3 mb-1">My Orders</h1>
                <div class="text-muted small">Your purchase history and order details.</div>
            </div>

            <a class="btn btn-outline-secondary" asp-page="/Games/Index">
                <i class="bi bi-joystick me-1"></i>Browse games
            </a>
        </div>
    </div>
</div>

<form method="get" class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Order ID</label>
                <input name="orderId"
                       value="@Request.Query["orderId"]"
                       class="form-control"
                       placeholder="#123" />
            </div>

            <div class="col-md-3">
                <label class="form-label">From</label>
                <input type="date"
                       name="from"
                       value="@Request.Query["from"]"
                       class="form-control" />
            </div>

            <div class="col-md-3">
                <label class="form-label">To</label>
                <input type="date"
                       name="to"
                       value="@Request.Query["to"]"
                       class="form-control" />
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button class="btn btn-outline-secondary" type="submit">
                    <i class="bi bi-search me-1"></i>Search
                </button>

                @if (!string.IsNullOrWhiteSpace(Request.Query["orderId"]) ||
                     !string.IsNullOrWhiteSpace(Request.Query["from"]) ||
                     !string.IsNullOrWhiteSpace(Request.Query["to"]))
                {
                    <a class="btn btn-outline-secondary" asp-page="./Index">
                        <i class="bi bi-x-lg me-1"></i>Clear
                    </a>
                }
            </div>
        </div>
    </div>
</form>

@if (Model.Orders.Count == 0)
{
    <div class="empty-state text-center">
        <h5 class="mb-2">No orders yet</h5>
        <p class="text-muted mb-3">Once you complete a purchase, your orders will appear here.</p>
        <a class="btn btn-primary" asp-page="/Games/Index">
            <i class="bi bi-joystick me-1"></i>Start shopping
        </a>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                    <tr>
                        <th>Order #</th>
                        <th>Date</th>
                        <th class="text-end">Total</th>
                        <th class="text-end text-muted">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var o in Model.Orders)
                    {
                        <tr>
                            <td class="fw-semibold">#@o.Id</td>
                            <td>@o.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="text-end fw-semibold">@o.TotalPrice.ToString("0.00") €</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary"
                                   asp-page="/Orders/Details"
                                   asp-route-id="@o.Id"
                                   title="View order details">
                                    <i class="bi bi-eye me-1"></i>Details
                                </a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}